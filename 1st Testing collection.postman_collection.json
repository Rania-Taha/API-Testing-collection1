							"",
							"",
							"    pm.expect(myResponce.msg).to.eql(\"book is successfully deleted\");",
							"    pm.response.to.have.status(200);",
							"    ",
							"}) "
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
