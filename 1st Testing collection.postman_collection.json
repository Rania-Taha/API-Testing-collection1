	"item": [
		{
			"name": "Get Book By ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let myResponce = pm.response.json(); // Parse the response body as JSON ",
							"",
							"pm.test(\"Check if the response contains the correct message\", function () {",
							"",
							"    pm.expect(myResponce).to.have.length(1)",
							"    ",
							"",
							"    pm.response.to.have.status(200);",
							"",
							"})"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseURL}}GetBook.php?ID={{NewGeneratedID}}",
					"host": [
						"{{baseURL}}GetBook",
						"php"
					],
					"query": [
						{
							"key": "ID",
							"value": "{{NewGeneratedID}}"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Add Book",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let color = pm.variables.replaceIn('{{$randomColor}}') ",
							"let month = pm.variables.replaceIn('{{$randomMonth}}') ",
							"let isbn = pm.variables.replaceIn('{{$randomInt}}')*500",
							"let aisle = pm.variables.replaceIn('{{$randomInt}}')*350",
							"let author =  pm.variables.replaceIn('{{$randomFullName}}')",
							"",
							"",
							"console.log(color + \" \" + month)",
							"console.log(isbn)",
							"console.log(aisle)",
							"console.log(author)",
							"",
							"",
							"pm.collectionVariables.set(\"NewBookName\",  color + \" \" + month);",
							"pm.collectionVariables.set(\"NewIsbn\",  isbn);",
							"pm.collectionVariables.set(\"NewAisle\",  aisle);",
							"pm.collectionVariables.set(\"NewAuthorName\", author);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"let myResponce = pm.response.json();",
							"",
							"",
							"pm.collectionVariables.set(\"NewGeneratedID\" ,myResponce.ID)",
							"",
							"pm.test(\"Check if the response message is as expected\", function () { ",
							"    pm.expect(myResponce.Msg).to.eql(\"successfully added\");",
							"",
							"    pm.response.to.have.status(200);",
							"    ",
							"});",
							"",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"{{NewBookName}}\",\n    \"isbn\": \"{{NewIsbn}}\",\n    \"aisle\": \"{{NewAisle}}\",\n    \"author\": \"{{NewAuthorName}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseURL}}Addbook.php",
					"host": [
						"{{baseURL}}Addbook",
						"php"
					]
				}
			},
			"response": []
		},
		{
			"name": "Delete a Book",
